rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for zero-trust access & payload bounds
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User account, profiles, CRM contacts, and subscription mirror
    // Strictly scoped to the authenticated Firebase UID (GDPR & Store Data Safety)
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().size() <= 25;

      match /{allSubcollections=**} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Public digital business cards (/p/:slug)
    // Readable by anyone via QR/NFC link; writable/deletable only by the card owner
    match /public_cards/{slug} {
      allow read: if true;
      allow create: if isSignedIn()
                    && slug.size() >= 2
                    && slug.size() <= 80
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().size() <= 20;
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().size() <= 20;
      allow delete: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
