rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User media assets (avatars, banners, company logos, portfolio media)
    // Publicly readable for shared digital business cards; write/delete restricted to owner
    // Enforce 10MB max upload size and image/video/pdf MIME types
    match /users/{userId}/media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

