# ============================================================================
# 1. GOOGLE GEMINI AI & BACKEND ORIGIN CONFIGURATION
# ============================================================================
# GEMINI_API_KEY: Required for server-side Gemini AI API calls (Bio, Banner, OCR, KYC).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where the backend server is hosted (e.g. Cloud Run).
APP_URL="https://youconnect.app"

# VITE_API_BASE_URL: Required for Native iOS & Android Capacitor builds so mobile
# WebViews route /api/* and WebSocket traffic to your production backend instead of capacitor://localhost.
VITE_API_BASE_URL="https://api.youconnect.app"

# VITE_PUBLIC_WEB_ORIGIN: Used to generate shareable QR and NFC Universal Links (/p/:slug)
# inside native iOS/Android builds.
VITE_PUBLIC_WEB_ORIGIN="https://youconnect.app"

# ============================================================================
# 2. FIREBASE CONFIGURATION (Auth, Cloud Firestore, Cloud Storage)
# ============================================================================
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="youconnect-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="youconnect-prod"
VITE_FIREBASE_STORAGE_BUCKET="youconnect-prod.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# ============================================================================
# 3. REVENUECAT CONFIGURATION (Apple StoreKit 2, Google Play Billing, Web)
# ============================================================================
# Obtain public SDK keys from RevenueCat Dashboard -> Project Settings -> API Keys
# iOS Public API Key (starts with appl_...)
VITE_REVENUECAT_APPLE_API_KEY="appl_YOUR_REVENUECAT_IOS_PUBLIC_KEY"

# Android Public API Key (starts with goog_...)
VITE_REVENUECAT_GOOGLE_API_KEY="goog_YOUR_REVENUECAT_ANDROID_PUBLIC_KEY"

# Web Billing Public API Key (starts with rcob_...)
VITE_REVENUECAT_WEB_API_KEY="rcob_YOUR_REVENUECAT_WEB_PUBLIC_KEY"

# Server-to-Server Webhook Authorization Secret (configured in RevenueCat -> Integrations -> Webhooks)
REVENUECAT_WEBHOOK_AUTH_SECRET="rc_whsec_YOUR_WEBHOOK_SECRET"

# ============================================================================
# 4. UNIVERSAL LINKS & ANDROID APP LINKS (.well-known)
# ============================================================================
# Apple Developer 10-character Team ID for /.well-known/apple-app-site-association
APPLE_TEAM_ID="TEAMID1234"

# Android Signing Keystore SHA-256 fingerprint for /.well-known/assetlinks.json
ANDROID_CERT_SHA256="FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C"
